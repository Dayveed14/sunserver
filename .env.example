# Copy to .env and fill in.

NODE_ENV=development
PORT=4000
# Where the React app runs (used for CORS). Vite's default:
CLIENT_ORIGIN=http://localhost:5173

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sunledger

# Sessions — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7
BCRYPT_ROUNDS=12

# Resend (verification OTP emails). Leave RESEND_API_KEY empty in development and the
# code is printed in the server console instead of emailed.
RESEND_API_KEY=
# To email real users you must verify a domain in Resend and use an address on it.
# The default onboarding@resend.dev sender only delivers to your own Resend account email.
MAIL_FROM=Sunledger <onboarding@resend.dev>

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx) so rate limits see real IPs.
TRUST_PROXY=0

# 1 = only vendors with verification_status='verified' appear to customers. Leave 0 until you have an
# admin way to verify vendors (rejected vendors are always hidden).
VENDOR_APPROVAL_REQUIRED=0

# ---- Payments and order emails (Phase 4) ----
# Paystack secret key (sk_test_... while testing, sk_live_... when real). Leave EMPTY in development to use the
# built-in simulated payment page. In production this is required.
PAYSTACK_SECRET_KEY=
# The logistics partner's address: gets "please send a rider" and pickup/delivery emails, each with a one-tap link.
LOGISTICS_EMAIL=
# The admin address that receives a copy of every order email and every payment problem.
ADMIN_NOTIFY_EMAIL=

# ---- Pictures (Cloudinary) ----
# Paste the "API environment variable" from your Cloudinary dashboard (looks like cloudinary://KEY:SECRET@CLOUD_NAME).
# Leave empty in development to keep pictures in the database instead.
CLOUDINARY_URL=
